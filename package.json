{
  "name": "Have a Cookie Bot",
  "version": "1.0.0",
  "description": "The bot that builds stronger, happier communities through rewards and recongition.",
  "license": "AGPLv3",
  "main": "dist/bot.js",
  "scripts": {
    "start": "node dist/bot.js",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/bot.ts",
    "register-commands": "tsx src/registerCommands.ts",
    "lint": "oxlint src scripts",
    "format": "oxfmt --write src scripts package.json tsconfig.json",
    "format:check": "oxfmt --check src scripts package.json tsconfig.json"
  },
  "dependencies": {
    "cron": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "discord.js": "^14.26.4",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sequelize": "^6.37.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "authors": "Fiverr.com/mdaniels6758, github.com/candidexmedia"
}
